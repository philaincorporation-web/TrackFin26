# Copier en .env.local et renseigner. Ne jamais committer de valeurs réelles.

# Neon — connexion poolée (application) et directe (migrations Prisma)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Better Auth — secret aléatoire de 32 octets minimum, URL publique de l'application
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
