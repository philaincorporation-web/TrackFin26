# Copier en .env.local et renseigner. Ne jamais committer de valeurs réelles.

# Neon — connexion poolée (application) et directe (migrations Prisma)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Better Auth — secret aléatoire de 32 octets minimum, URL publique de l'application
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Envoi d'e-mails (SMTP) — Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER = l'adresse Gmail, SMTP_PASSWORD = un « mot de passe d'application »
# Google (16 caractères, compte avec validation en deux étapes), jamais le mot de passe Gmail.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=DIWAA Finance · DigiWomen School
